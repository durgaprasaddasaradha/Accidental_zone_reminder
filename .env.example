# ==============================================================================
# Accidental Zone Reminder System - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env or any file containing real credentials to version control.
# ==============================================================================

# ── Supabase Configuration (Backend Only) ─────────────────────────────────────
# These are server-side secrets. NEVER expose them to the frontend.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── FastAPI Backend Server (local development) ─────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── CORS (Production Only) ─────────────────────────────────────────────────────
# Set this to your Vercel frontend URL in production (Render dashboard env var).
# Comma-separated list for multiple origins.
# Example: ALLOWED_ORIGINS=https://accidental-zone-reminder.vercel.app
# Leave empty locally — localhost:5173 is always allowed automatically.
ALLOWED_ORIGINS=

# ── Frontend API Endpoint (Vite build-time variable) ──────────────────────────
# For local development: leave empty (Vite proxy handles /api → localhost:8000)
# For production build: set to your Render backend URL BEFORE running npm run build
# Example: VITE_API_URL=https://accidental-zone-reminder-api.onrender.com
VITE_API_URL=
